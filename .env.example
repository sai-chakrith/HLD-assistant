DATA_DIR=data
CHROMA_DIR=chroma
DB_PATH=data/hld.db
EMBED_MODEL=BAAI/bge-small-en-v1.5
# Local models only: no cloud LLM APIs, no API keys. LLM_PROVIDER is ollama|none (none = tests/offline stub).
LLM_PROVIDER=ollama
SIMILARITY_THRESHOLD=0.65
HIGH_SCORE=0.75
FUZZY_THRESHOLD=88
CHUNK_TARGET_TOKENS=500
CHUNK_MAX_TOKENS=600
CHUNK_OVERLAP_TOKENS=50
OLLAMA_BASE_URL=http://localhost:11434
# Single local model for answers, summaries and structured extraction
OLLAMA_MODEL=qwen3:4b-instruct
# Interactive requests (Q&A, component reports, document summaries): qwen3, kept loaded and warmed at start-up
# (author's post-hoc choice, see eval/results.md "Deployed configuration")
DEMO_MODEL=qwen3:4b-instruct
DEMO_KEEP_ALIVE=30m
# The same model handles optional prose extraction (use_llm)
LLM_EXTRACT_MODEL=qwen3:4b-instruct
LLM_EXTRACT_CHUNK_CHARS=500
ALLOWED_MODELS=qwen3:4b-instruct
TRACE_PATH=data/traces.jsonl
# OCR for scanned pages (needs the Tesseract binary; TESSERACT_CMD optional, Windows default path auto-detected)
OCR_ENABLED=true
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# Set WARMUP=0 to skip the API start-up warm-up (embedder load + 1-token Ollama prompt)
WARMUP=1
# Retrieval stages (true/false): BM25+dense fusion, version/identifier query understanding, inventory evidence,
# section expansion; expansion and the cross-encoder reranker are off (they lowered dev-set correctness)
RETRIEVAL_HYBRID=true
RETRIEVAL_QUERY_UNDERSTANDING=true
RETRIEVAL_INVENTORY=true
RETRIEVAL_EXPAND=false
RETRIEVAL_RERANK=false

# Optional authentication for shared use: JSON mapping seeded usernames to SHA-256 token hashes.
# When present, demo identity headers and role cookies cannot select another account.
# HLD_AUTH_TOKEN_HASHES={"reviewer":"<64-character lowercase SHA-256 digest>"}
RETRIEVAL_CANDIDATES=20
RETRIEVAL_CONTEXT_TOKENS=2800
